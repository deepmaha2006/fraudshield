# FraudShield — environment configuration (PLACEHOLDERS ONLY — never commit real values).
# Copy to .env (development) or inject via your secret manager / systemd
# EnvironmentFile / container secrets (production). Validate with:
#   NODE_ENV=production npm run check:config

# --- runtime -----------------------------------------------------------------
NODE_ENV=development            # production | development | test
PORT=3000
# HOST defaults to 127.0.0.1 in production (behind a TLS reverse proxy), 0.0.0.0 otherwise
# HOST=127.0.0.1

# --- data ----------------------------------------------------------------------
DB_FILE=fraudshield.db          # path relative to fraudshield-backend/ or absolute; keep OUTSIDE public/
# Hosts without a persistent disk (e.g. Render free): use a hosted database instead.
# When DATABASE_URL is set, DB_FILE is ignored.
#   PostgreSQL / Supabase (session pooler, TLS verified against certs/supabase-ca.crt):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=fraudshield   # tables live here, not in `public`, so Supabase's Data API can't reach them
# DATABASE_POOL_SIZE=5
# DATABASE_CA_FILE=             # another provider's CA bundle (default: certs/supabase-ca.crt)
#   libSQL / Turso:
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=REPLACE_WITH_TURSO_TOKEN
DETECTION_RETENTION_DAYS=180    # detections older than this are purged automatically

# 32 random bytes as 64 hex chars. Encrypts stored Gmail App Passwords (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes stored Gmail credentials unreadable (users must reconnect Gmail).
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# --- web / sessions --------------------------------------------------------------
# Required in production: the exact https:// origin users open (no trailing slash).
PUBLIC_BASE_URL=https://fraudshield.example.com
# Required in production: which proxy may set X-Forwarded-* (e.g. loopback, 10.0.0.5), or a hop
# count such as 1 for a platform load balancer (Render). Never "true".
TRUST_PROXY=loopback
# Secure cookies; defaults to true in production and must not be disabled there.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=12            # absolute session lifetime
SESSION_IDLE_MINUTES=120        # sign out after this much inactivity
ALLOW_REGISTRATION=true         # set false to close public sign-up
# RATE_LIMIT_SCALE=1            # multiplier for per-IP limits only (e.g. users behind shared NAT)

# --- CAPTCHA (Cloudflare Turnstile) -----------------------------------------------
# Create a site at https://dash.cloudflare.com → Turnstile. Add this origin.
# SITE_KEY goes in the frontend; SECRET_KEY stays server-side.
# REQUIRED IN PRODUCTION — startup fails if either key is missing.
# Bypass (NODE_ENV=test only): if neither key is set, CAPTCHA is skipped automatically.
# For manual testing: site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
# TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# --- outbound mail (alerts + password reset) -------------------------------------
# MAIL_TRANSPORT = gmail | smtp   (memory is test-only; disabled is refused in production)
# REQUIRED IN PRODUCTION — startup fails if not configured.
MAIL_TRANSPORT=gmail
MAIL_FROM=alerts@example.com
# gmail: a dedicated sending account + Google App Password (port 465, implicit TLS)
# WARNING: Render free blocks outbound 465/587. Use smtp transport with a relay instead.
EMAIL_USER=alerts@example.com
EMAIL_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
# smtp: TLS is required and certificates are verified.
# Render free blocks 25/465/587. Use an alternate port via a transactional relay:
#   Resend   → SMTP_HOST=smtp.resend.com  SMTP_PORT=2465
#   Mailgun  → SMTP_HOST=smtp.mailgun.org SMTP_PORT=2525  (STARTTLS)
#   Brevo    → SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 (blocked on Render free) or 2525
# Port auto-detection: 465/2465 → implicit TLS; everything else → STARTTLS
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=REPLACE_WITH_RELAY_API_KEY

# --- operations ------------------------------------------------------------------
LOG_LEVEL=info                  # debug | info | warn | error
# BACKUP_DIR=/var/backups/fraudshield
# BACKUP_KEEP=14

# Removed: JWT_SECRET and SESSION_SECRET are no longer used (sessions are server-side).
